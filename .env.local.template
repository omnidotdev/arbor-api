# database (required)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/arbor?schema=public"

# database connection used only for GraphQL query execution (optional).
# Defaults to DATABASE_URL. Point it at a constrained, non-superuser role to put
# GraphQL reads under row-level security without constraining authentication,
# git access, the merge queue, or webhooks, which run outside a GraphQL request
GRAPHQL_DATABASE_URL=""

# escape hatch for the boot-time row-level security check (optional).
# In production the API refuses to start if the GraphQL connection can bypass
# row-level security, since that silently removes the backstop. Set to "true"
# only to roll GRAPHQL_DATABASE_URL back to the privileged role on purpose
ALLOW_RLS_BYPASS=""

# auth
AUTH_BASE_URL="https://localhost:8000"

# payment processing
# https://docs.stripe.com/keys
STRIPE_API_KEY=""
# https://docs.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=""

# allowed origins for CORS (comma-separated)
CORS_ALLOWED_ORIGINS="https://localhost:3000"

# Condition to toggle `useAuth` plugin in development
PROTECT_ROUTES="true"

# Set to `1` to receive debug logs from `useAuth` plugin
AUTH_DEBUG=""

# maximum GraphQL query complexity cost (optional).
# Defaults to a built-in minimum when unset. Caps the cost of a single query so
# an expensive request cannot exhaust the server
GRAPHQL_MAX_COMPLEXITY_COST=""

# billing entitlements via Aether (optional).
# When BILLING_BASE_URL is unset, billing is disabled and callers fall back to
# free-tier limits. Required together to enforce paid tiers (graph_level, storage)
BILLING_BASE_URL=""
BILLING_SERVICE_API_KEY=""
# shared secret used to verify inbound Aether entitlement webhook signatures
# (optional). When unset, signature verification is skipped
BILLING_WEBHOOK_SECRET=""
# comma-separated organization IDs exempt from billing/tier limits (optional).
# Used for Omni internal orgs, which resolve to the highest capability tier
BILLING_BYPASS_ORG_IDS=""

# authorization policy decision point (optional).
# When AUTHZ_API_URL is unset, external authorization is disabled
AUTHZ_API_URL=""

# identity provider webhooks (optional).
# shared secret used to verify inbound IDP webhook signatures. When unset,
# signature verification is skipped
IDP_WEBHOOK_SECRET=""

# Vortex CloudEvents emission (optional).
# When either is unset, event streaming is disabled and events are dropped
VORTEX_API_URL=""
VORTEX_API_KEY=""

# Meilisearch unified search (optional).
# When either is unset, search indexing is disabled. Required together to enable
MEILISEARCH_URL=""
MEILISEARCH_MASTER_KEY=""

# arbor-git backend, a Rust/gitoxide gRPC daemon (optional).
# Off by default. When USE_ARBOR_GIT is "true" AND GIT_SERVICE_URL is set and
# reachable, git operations are delegated to arbor-git; otherwise the in-process
# path is used
USE_ARBOR_GIT=""
GIT_SERVICE_URL=""
# on-disk location of bare repositories for the in-process git path (optional).
# Defaults to /var/lib/arbor/repos
GIT_REPOS_PATH=""
