{
  "name": "@omnidotdev/arbor-api",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "main": "build/server.js",
  "module": "build/server.js",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development GRAPHILE_ENV=development bun run --env-file .env.local --env-file .env.development --watch src/server.ts",
    "build": "bun build --target node --outdir build src/server.ts",
    "start": "NODE_ENV=production GRAPHILE_ENV=production bun run src/scripts/db/migrate.ts && NODE_ENV=production GRAPHILE_ENV=production bun run build/server.js",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "knip": "knip-bun",
    "db:check": "bun --env-file .env.local drizzle-kit check --config src/lib/config/drizzle.config.ts",
    "db:generate": "bun --env-file .env.local drizzle-kit generate --config src/lib/config/drizzle.config.ts",
    "db:migrate": "bun --env-file .env.local drizzle-kit migrate --config src/lib/config/drizzle.config.ts && GRAPHILE_ENV=development bun graphql:generate",
    "db:migrate:drop": "bun --env-file .env.local drizzle-kit drop --config src/lib/config/drizzle.config.ts",
    "db:pull": "bun --env-file .env.local drizzle-kit introspect --config src/lib/config/drizzle.config.ts",
    "db:push": "bun --env-file .env.local drizzle-kit push --config src/lib/config/drizzle.config.ts",
    "db:seed": "NODE_ENV=development bun run --env-file .env.local src/scripts/db/seedDatabase.ts",
    "db:studio": "bun --env-file .env.local drizzle-kit studio --config src/lib/config/drizzle.config.ts",
    "db:up": "bun --env-file .env.local drizzle-kit up --config src/lib/config/drizzle.config.ts",
    "graphql:generate": "GRAPHILE_ENV=development bun run --env-file .env.local src/scripts/generateGraphqlSchema.ts",
    "prepare": "husky",
    "tls:generate": "bun src/scripts/generateTlsCert.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/graphql-yoga": "^1.4.1",
    "@envelop/generic-auth": "^11.1.1",
    "@envelop/opentelemetry": "^9.1.1",
    "@envelop/parser-cache": "^10.1.1",
    "@envelop/validation-cache": "^10.1.1",
    "@escape.tech/graphql-armor": "^3.2.0",
    "@graphile/pg-aggregates": "^0.2.0-rc.2",
    "@graphile/simplify-inflection": "^8.0.0",
    "@graphql-yoga/plugin-disable-introspection": "^2.22.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@omnidotdev/providers": "github:omnidotdev/providers#49f2fc4",
    "@omnidotdev/search": "github:omnidotdev/search",
    "@tanstack/query-core": "^5.101.1",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.29",
    "grafast": "^1.0.2",
    "graphile-export": "^1.0.1",
    "graphql": "^16.14.2",
    "graphql-yoga": "^5.21.2",
    "isomorphic-git": "^1.38.5",
    "jose": "^6.2.3",
    "ms": "^2.1.3",
    "pg": "^8.22.0",
    "postgraphile": "^5.0.3",
    "postgraphile-plugin-connection-filter": "^3.0.1",
    "stripe": "^22.2.3",
    "zod": "4.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@types/bun": "^1.3.14",
    "@types/ms": "^2.1.0",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "knip": "^6.18.0",
    "typescript": "^6.0.3"
  },
  "trustedDependencies": [
    "@biomejs/biome"
  ]
}
