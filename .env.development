# development environment variables
NODE_ENV=development

# Git repository storage path (writable directory for development)
GIT_REPOS_PATH="./data/repos"

AUTH_BASE_URL="https://localhost:8000"

# never use in production; disable certificate validation (useful for development environments to avoid having to manually trust a self-signed certificate)
# reference: https://nodejs.org/api/cli.html#node_tls_reject_unauthorizedvalue
NODE_TLS_REJECT_UNAUTHORIZED="0"
